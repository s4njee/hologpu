{
  "name": "@mk7s/hologpu-core",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spikes": {
      "source": "./src/spikes.ts",
      "types": "./dist/spikes.d.ts",
      "import": "./dist/spikes.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "license": "MIT",
  "description": "Core WebGPU runtime: device management, scheduling, resources and shared WGSL.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s4njee/hologpu.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/s4njee/hologpu",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
