{
  "name": "@mk7s/hologpu-dom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/register.ts",
    "./dist/register.js"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "source": "./src/register.ts",
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@mk7s/hologpu-core": "workspace:*"
  }
}
