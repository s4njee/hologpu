    "./voronoi": {
      "source": "./src/voronoi/index.ts",
      "types": "./dist/voronoi/index.d.ts",
      "import": "./dist/voronoi/index.js"
    },
    "./sdf-2d": {
      "source": "./src/sdf-2d/index.ts",
      "types": "./dist/sdf-2d/index.d.ts",
      "import": "./dist/sdf-2d/index.js"
    },
    "./raymarch": {
      "source": "./src/raymarch/index.ts",
      "types": "./dist/raymarch/index.d.ts",
      "import": "./dist/raymarch/index.js"
