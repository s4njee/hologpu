{
  "name": "hologpu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @mk7s/hologpu-playground dev",
    "publish:mk7s": "node scripts/publish-site-mk7s.mjs",
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run && node scripts/check-catalogue.mjs",
    "test:browser": "playwright test",
    "test:lcd": "pnpm --filter @mk7s/hologpu-playground build && playwright test --config playwright.lcd.config.ts",
    "test:fluid-dom": "pnpm --filter @mk7s/hologpu-playground build && playwright test --config playwright.fluid-dom.config.ts",
    "test:hardware": "playwright test --config playwright.hardware.config.ts",
    "benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm catalogue:check && pnpm typecheck && pnpm test && pnpm build && pnpm check:server && pnpm check:package && pnpm test:browser",
    "check:server": "node scripts/check-server-imports.mjs",
    "catalogue": "node scripts/catalogue.mjs",
    "catalogue:check": "node scripts/catalogue.mjs --check",
    "check:package": "node scripts/check-packages.mjs",
    "benchmark:m1": "node scripts/benchmark-m1.mjs",
    "benchmark:m2": "node scripts/benchmark-m2.mjs",
    "benchmark:m3": "node scripts/benchmark-m3.mjs",
    "benchmark:m4": "node scripts/benchmark-m4.mjs",
    "benchmark:m6": "node scripts/benchmark-m6.mjs",
    "benchmark:m5": "node scripts/benchmark-m5.mjs",
    "benchmark:m5-page": "node scripts/benchmark-m5-page.mjs",
    "benchmark:m7": "node scripts/benchmark-m7.mjs",
    "poster": "node scripts/poster.mjs",
    "benchmark:v2-backgrounds": "node scripts/benchmark-v2-backgrounds.mjs",
    "benchmark:v2-typography": "node scripts/benchmark-v2-typography.mjs",
    "benchmark:v2-cards": "node scripts/benchmark-v2-cards.mjs",
    "benchmark:v2-products": "node scripts/benchmark-v2-products.mjs",
    "benchmark:v2-transitions": "node scripts/benchmark-v2-transitions.mjs",
    "benchmark:v2-ambient": "node scripts/benchmark-v2-ambient.mjs",
    "bundle:size": "node scripts/bundle-size.mjs",
    "bundle:check": "node scripts/bundle-size.mjs --json node_modules/.cache/bundle-size.json && node scripts/check-bundle-budget.mjs --report node_modules/.cache/bundle-size.json",
    "benchmark:firefox-submissions": "node scripts/benchmark-firefox-submissions.mjs",
    "benchmark:v2-launch": "node scripts/benchmark-v2-launch.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@webgpu/types": "^0.1.69",
    "prettier": "~3.9.8",
    "publint": "^0.3.25",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "description": "WebGPU effect runtime and effect library, shipped as the @mk7s/hologpu packages.",
  "repository": {
    "type": "git",
    "url": "https://github.com/s4njee/hologpu.git"
  },
  "homepage": "https://github.com/s4njee/hologpu"
}
